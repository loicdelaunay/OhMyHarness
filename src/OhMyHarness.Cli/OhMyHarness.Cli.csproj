<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>omh</AssemblyName>
    <RootNamespace>OhMyHarness.Cli</RootNamespace>
    <Version>1.9.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../OhMyHarness.Core/OhMyHarness.Core.csproj" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="OhMyHarness.Cli.Tests" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Fonts/**/*" /></ItemGroup>
  <ItemGroup><AssemblyMetadata Include="OhMyHarness.SingleFile" Value="$(PublishSingleFile)" /></ItemGroup>
  <Import Project="../../build/PythonRuntime.targets" />
</Project>
